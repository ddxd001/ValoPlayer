{
  "name": "valoplayer",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle",
    "setup:media": "node scripts/setup-media.mjs",
    "test:rust": "node scripts/desktop.mjs test",
    "package:windows": "node scripts/package-windows.mjs",
    "installer:build": "node scripts/desktop.mjs build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.1.1"
  }
}
